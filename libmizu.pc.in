prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libmizu
Description: Lock-free shared-memory IPC: SPSC channels and work-stealing task pools
URL: https://github.com/shikokuchuo/libmizu
Version: @VERSION@
Libs: -L${libdir} -lmizu
Libs.private: @LIBS_PRIVATE@
Cflags: -I${includedir}
