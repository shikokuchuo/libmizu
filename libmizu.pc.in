prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libmizu
Description: Thread-speed, lock-free shared memory IPC in C11
URL: https://github.com/shikokuchuo/libmizu
Version: @VERSION@
Libs: -L${libdir} -lmizu
Libs.private: @LIBS_PRIVATE@
Cflags: -I${includedir}
